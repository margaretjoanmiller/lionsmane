{
  "languages": {
    "TypeScript": {
      "language_servers": [
        "typescript-ls",
        "eslint",
        "!vtsls",
        "!typescript-language-server",
        "..."
      ],
      "format_on_save": "on",
      "prettier": {
        "allowed": true
      },
    },
    "TSX": {
      "language_servers": [
        "typescript-ls",
        "eslint",
        "!vtsls",
        "!typescript-language-server",
        "..."
      ],
      "format_on_save": "on",
      "prettier": {
        "allowed": true
      },
    },
    "Svelte": {
      "format_on_save": "on",
      "prettier": {
        "allowed": true
      },
    },
  }
}
